# Security Investigation Agent 本地配置模板。
# 复制为 .env 后填写自己的密钥；不要提交 .env。

# 任选一种已支持的模型提供方。无密钥时可设置 USE_FAKE_MODEL=true 验证流程。
USE_FAKE_MODEL=false
DEFAULT_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AIGCBEST_API_KEY=
AIGCBEST_BASE_URL=https://api2.aigcbest.top
AIGCBEST_EMBEDDING_MODEL=text-embedding-3-small
PRIVATE_GATEWAY_API_KEY=
PRIVATE_GATEWAY_BASE_URL=
PRIVATE_GATEWAY_API_PATH=/v1/chat/completions

# 本地服务与前端。
HOST=0.0.0.0
PORT=8080
STREAMLIT_PORT=18501
# 前后端分开部署时填写，例如 http://127.0.0.1:8080。
AGENT_URL=
SECURITY_FRONTEND_URL=

# SQLite 数据库、知识库与检索模式。留空时使用仓库内默认位置。
SECURITY_DB_PATH=
SECURITY_KNOWLEDGE_DIR=
SECURITY_VECTOR_DB_PATH=
# auto：优先向量；lexical：只用本地关键词；vector：强制向量。
SECURITY_RAG_MODE=auto

# 单实例留空时自动生成本地密钥；多实例需设置同一个至少 32 字符的密钥。
SECURITY_JWT_SECRET=
